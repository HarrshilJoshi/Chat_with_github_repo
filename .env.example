# Groq API Key (Primary high-speed LLM inference)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Primary Groq Model ID (Default: openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini API Key (Optional fallback buffer LLM)
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Fallback Model (Default: gemini-3-flash-preview)
# Note: gemini-3-flash-preview is an experimental preview model
GEMINI_FALLBACK_MODEL=gemini-3-flash-preview

# GitHub Personal Access Token (Optional: increases rate limits from 60 to 5,000 req/hr)
# Generate a token with 'repo' scope at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# Default Cosine Similarity Threshold (Range: 0.10 - 0.70, Default: 0.30)
DEFAULT_SIMILARITY_THRESHOLD=0.30
